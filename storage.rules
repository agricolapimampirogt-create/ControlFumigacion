rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    match /crop-photos/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /settings/{fileName} {
      allow read: if true;
      allow write: if signedIn();
    }
  }
}
