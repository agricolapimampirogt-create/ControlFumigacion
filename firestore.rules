rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isBootstrapAdmin() {
      return signedIn() && request.auth.token.email in [
        "adminagricola@gmail.com",
        "agricolapimampirogt@gmail.com"
      ];
    }

    function hasUserProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isBootstrapAdmin() || (hasUserProfile() && currentUser().rol == "admin");
    }

    function isTechnician() {
      return hasUserProfile() && currentUser().rol == "tecnico";
    }

    match /users/{userId} {
      allow read: if signedIn() && (isAdmin() || request.auth.uid == userId);
      allow write: if isAdmin();
    }

    match /clients/{id} {
      allow read: if signedIn();
      allow write: if isAdmin() || isTechnician();
      allow delete: if isAdmin();
    }

    match /crops/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /pests/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /products/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /sites/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /fumigationStages/{id} {
      allow read: if isAdmin() || (isTechnician() && resource.data.technicianId == request.auth.uid);
      allow create: if isAdmin() || (isTechnician() && request.resource.data.technicianId == request.auth.uid);
      allow update: if isAdmin() || (isTechnician() && resource.data.technicianId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /publicStages/{id} {
      allow read: if true;
      allow write: if isAdmin() || isTechnician();
      allow delete: if isAdmin();
    }

    match /notifications/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || isTechnician();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
